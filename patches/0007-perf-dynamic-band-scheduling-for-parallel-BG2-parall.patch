From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Marc=20T=C3=B6nsing?= <mtoensing@users.noreply.github.com>
Date: Tue, 29 Sep 2026 17:30:45 +0200
Subject: [PATCH] perf: dynamic band scheduling for parallel BG2, parallel HDR
 pass, shift/mask tile addressing, more profile stages


diff --git a/include/starfox/app/frame_profile.hpp b/include/starfox/app/frame_profile.hpp
index badc144..3ac292a 100644
--- a/include/starfox/app/frame_profile.hpp
+++ b/include/starfox/app/frame_profile.hpp
@@ -49,6 +49,10 @@ enum class Stage : unsigned {
     tick_only,     // game.tick duration, recorded on tick frames only
     rtx_lighting,  // CPU RTX lighting pass (inside effects)
     hdr_effect,    // CPU HDR curve pass (inside effects)
+    cpu_shadow,    // CPU shadow-mask darkening (inside effects)
+    overlay,       // FPS overlay painting (inside effects)
+    bg2,           // BackgroundRenderer::draw_bg2, all calls in the frame
+    bg2_calls,     // number of draw_bg2 calls per frame (1 ms == 1 call)
     count
 };
 
@@ -219,7 +223,7 @@ public:
             "logic", "audio", "background", "world", "composite", "expand",
             "effects", "update_texture", "render_texture", "render_present",
             "present_total", "frame_work", "pacer_wait", "frame_interval",
-            "tick_only", "rtx_lighting", "hdr_effect"};
+            "tick_only", "rtx_lighting", "hdr_effect", "cpu_shadow", "overlay", "bg2", "bg2_calls"};
         out << "profile-frames=" << frames_ << " vsync=" << (vsync ? 1 : 0) << '\n';
         char line[192];
         for (unsigned i = 0; i < static_cast<unsigned>(Stage::count); ++i) {
diff --git a/include/starfox/render/hdr_effect.hpp b/include/starfox/render/hdr_effect.hpp
index 02fd3b3..27733e5 100644
--- a/include/starfox/render/hdr_effect.hpp
+++ b/include/starfox/render/hdr_effect.hpp
@@ -1,5 +1,6 @@
 #pragma once
 #include "starfox/render/framebuffer.hpp"
+#include "starfox/render/row_workers.hpp"
 #include <array>
 #include <cmath>
 
@@ -7,7 +8,8 @@ namespace starfox::render {
 // SDR brightness/contrast styling only: does not request an HDR swapchain,
 // change display metadata, or claim additional physical display headroom.
 inline void apply_hdr_effect(const Framebuffer& frame,
-    std::vector<std::uint8_t>& rgba, std::uint8_t intensity) {
+    std::vector<std::uint8_t>& rgba, std::uint8_t intensity,
+    RowWorkers* workers = nullptr) {
     if (intensity==0 || intensity>3 || !frame.layer_tags_enabled()
         || rgba.size()!=frame.pixels().size()*4U) return;
     std::array<std::uint8_t,256> curve{};
@@ -21,10 +23,16 @@ inline void apply_hdr_effect(const Framebuffer& frame,
             255*(lifted*(1-contrast)+shaped*contrast)));
     }
     const auto& tags=frame.layer_tags();
-    for (std::size_t pixel=0;pixel<frame.pixels().size();++pixel) {
-        if (tags[pixel]==static_cast<std::uint8_t>(PixelLayer::two_d)) continue;
-        for (unsigned channel=0;channel<3;++channel)
-            rgba[pixel*4+channel]=curve[rgba[pixel*4+channel]];
-    }
+    // Every pixel is independent, so the frame splits cleanly into row bands.
+    const std::size_t width=frame.stored_width();
+    const auto rows=frame.stored_height();
+    const auto band=[&](std::uint32_t first,std::uint32_t last) {
+        for (std::size_t pixel=std::size_t(first)*width;pixel<std::size_t(last)*width;++pixel) {
+            if (tags[pixel]==static_cast<std::uint8_t>(PixelLayer::two_d)) continue;
+            for (unsigned channel=0;channel<3;++channel)
+                rgba[pixel*4+channel]=curve[rgba[pixel*4+channel]];
+        }
+    };
+    if (workers!=nullptr) workers->parallel_rows(rows,band); else band(0U,rows);
 }
 } // namespace starfox::render
diff --git a/src/app/starfox_pc.cpp b/src/app/starfox_pc.cpp
index 84303e3..20f0961 100644
--- a/src/app/starfox_pc.cpp
