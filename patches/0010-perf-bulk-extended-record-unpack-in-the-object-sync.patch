     void unpack_base_bytes(ObjectHandle handle, std::uint16_t first, std::uint16_t last, const std::uint8_t* in);
+    // Equivalent to write_path_byte(handle, 0x80 + i, in[i]) for i in [0, count).
+    void unpack_extended_bytes(ObjectHandle handle, const std::uint8_t* in, std::size_t count);
     void write_base_word(ObjectHandle handle, std::uint16_t offset, std::uint16_t value);
     void write_base_long(ObjectHandle handle, std::uint16_t offset, std::uint32_t value);
