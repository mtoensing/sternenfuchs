--- a/include/starfox/simulation/wdc65816.hpp
+++ b/include/starfox/simulation/wdc65816.hpp
@@ -122,6 +122,13 @@ public:
     [[nodiscard]] std::optional<std::uint16_t> peek_ram16(std::uint32_t address) const noexcept;
     void write8(std::uint32_t address, std::uint8_t value);
     void write16(std::uint32_t address, std::uint16_t value);
+    // Bulk copies for ranges that lie entirely in plain work RAM ($7E/$7F, or
+    // the $0000-$1FFF mirror in banks $00-$3F/$80-$BF). They have exactly the
+    // effect of the same run of read8/write8 calls, minus the per-byte bus
+    // dispatch. Return false, having touched nothing, for any other range so
+    // the caller can fall back to the byte accessors.
+    [[nodiscard]] bool read_wram_block(std::uint32_t address, std::uint8_t* out, std::size_t count) const noexcept;
+    [[nodiscard]] bool write_wram_block(std::uint32_t address, const std::uint8_t* in, std::size_t count) noexcept;
     [[nodiscard]] bool load_cartridge_ram(
         std::span<const std::uint8_t> bytes) noexcept;
     [[nodiscard]] std::span<const std::uint8_t> cartridge_ram() const noexcept;
