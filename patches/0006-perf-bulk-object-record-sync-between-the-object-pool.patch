From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Marc=20T=C3=B6nsing?= <mtoensing@users.noreply.github.com>
Date: Tue, 29 Sep 2026 17:21:06 +0200
Subject: [PATCH] perf: bulk object-record sync between the object pool and
 65C816 work RAM

Every strategy call re-syncs the whole object list in both directions, byte by
byte through a field-lookup chain, which was ~70% of the logic tick. Pack and
unpack each record in one unrolled pass and move it with a block copy; output is
byte-identical (frame and audio digests unchanged over 960 frames).

diff --git a/include/starfox/simulation/object_pool.hpp b/include/starfox/simulation/object_pool.hpp
index 304b757..18b5ff4 100644
--- a/include/starfox/simulation/object_pool.hpp
+++ b/include/starfox/simulation/object_pool.hpp
@@ -94,6 +94,11 @@ public:
     [[nodiscard]] std::uint8_t read_base_byte(ObjectHandle handle, std::uint16_t offset) const;
     [[nodiscard]] std::uint16_t read_base_word(ObjectHandle handle, std::uint16_t offset) const;
     void write_base_byte(ObjectHandle handle, std::uint16_t offset, std::uint8_t value);
+    // Bulk forms of read_base_byte/write_base_byte over offsets [first, last):
+    // out[i] / in[i] holds the byte at offset first + i. Identical results to
+    // the byte accessors, without a field lookup per byte.
+    void pack_base_bytes(ObjectHandle handle, std::uint16_t first, std::uint16_t last, std::uint8_t* out) const;
+    void unpack_base_bytes(ObjectHandle handle, std::uint16_t first, std::uint16_t last, const std::uint8_t* in);
     void write_base_word(ObjectHandle handle, std::uint16_t offset, std::uint16_t value);
     void write_base_long(ObjectHandle handle, std::uint16_t offset, std::uint32_t value);
     [[nodiscard]] std::uint8_t read_path_byte(ObjectHandle handle, std::uint8_t encoded_offset) const;
