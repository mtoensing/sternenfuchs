+template <ObjectMemoryLayout L>
+void pack_bytes(const GameObject& object, std::uint16_t first, std::uint16_t last, std::uint8_t* out) {
+    // Offsets 4..63 cover every record size (al_size is at most 57).
+#pragma GCC unroll 64
+    for (std::uint16_t offset = 4; offset < 64; ++offset) {
+        if (offset >= first && offset < last) {
+            out[offset - first] = read_base_byte_impl<L>(object, offset);
+        }
+    }
+}
+
+template <ObjectMemoryLayout L>
+void unpack_bytes(GameObject& object, std::uint16_t first, std::uint16_t last, const std::uint8_t* in) {
+#pragma GCC unroll 64
+    for (std::uint16_t offset = 4; offset < 64; ++offset) {
+        if (offset >= first && offset < last) {
+            write_base_byte_impl<L>(object, offset, in[offset - first]);
+        }
+    }
+}
+} // namespace
+
+std::uint8_t ObjectPool::read_base_byte(
+    ObjectHandle handle, std::uint16_t offset) const {
+    const auto& object = at(handle);
+    return layout_ == ObjectMemoryLayout::starfox_ex
+        ? read_base_byte_impl<ObjectMemoryLayout::starfox_ex>(object, offset)
+        : read_base_byte_impl<ObjectMemoryLayout::original>(object, offset);
+}
+
+std::uint16_t ObjectPool::read_base_word(
+    ObjectHandle handle, std::uint16_t offset) const {
+    return static_cast<std::uint16_t>(read_base_byte(handle, offset))
+        | (static_cast<std::uint16_t>(read_base_byte(handle, offset + 1U)) << 8U);
+}
+
+void ObjectPool::write_base_byte(
+    ObjectHandle handle, std::uint16_t offset, std::uint8_t value) {
+    auto& object = at(handle);
+    if (layout_ == ObjectMemoryLayout::starfox_ex) {
+        write_base_byte_impl<ObjectMemoryLayout::starfox_ex>(object, offset, value);
+    } else {
+        write_base_byte_impl<ObjectMemoryLayout::original>(object, offset, value);
+    }
+}
+
+void ObjectPool::pack_base_bytes(
+    ObjectHandle handle, std::uint16_t first, std::uint16_t last, std::uint8_t* out) const {
+    const auto& object = at(handle);
+    if (first < 4U || last > 64U || first > last) {
+        throw std::out_of_range{"alien-block byte range is outside al_size"};
+    }
+    if (layout_ == ObjectMemoryLayout::starfox_ex) {
+        pack_bytes<ObjectMemoryLayout::starfox_ex>(object, first, last, out);
+    } else {
+        pack_bytes<ObjectMemoryLayout::original>(object, first, last, out);
+    }
+}
+
+void ObjectPool::unpack_base_bytes(
+    ObjectHandle handle, std::uint16_t first, std::uint16_t last, const std::uint8_t* in) {
+    auto& object = at(handle);
+    if (first < 4U || last > 64U || first > last) {
+        throw std::out_of_range{"alien-block byte range is outside al_size"};
+    }
+    if (layout_ == ObjectMemoryLayout::starfox_ex) {
+        unpack_bytes<ObjectMemoryLayout::starfox_ex>(object, first, last, in);
+    } else {
+        unpack_bytes<ObjectMemoryLayout::original>(object, first, last, in);
+    }
+}
+
 void ObjectPool::write_base_word(
     ObjectHandle handle, std::uint16_t offset, std::uint16_t value) {
     write_base_byte(handle, offset, static_cast<std::uint8_t>(value));
