index 98399e1..ca40a44 100644
--- a/src/simulation/wdc65816.cpp
+++ b/src/simulation/wdc65816.cpp
@@ -2752,6 +2752,42 @@ void Wdc65816::write8(std::uint32_t address, std::uint8_t value) {
     impl_->write8(address, value);
 }
 
+namespace {
+// Index of `address` in work RAM when [address, address+count) is plain WRAM.
+std::optional<std::size_t> plain_wram_index(std::uint32_t address, std::size_t count, std::size_t wram_size) noexcept {
+    std::size_t index{};
+    std::size_t limit{};
+    if (address >= 0x7e0000U && address < 0x800000U) {
+        index = address - 0x7e0000U;
+        limit = 0x20000U;
+    } else {
+        const auto bank = address >> 16U, offset = address & 0xffffU;
+        if (!((bank < 0x40U) || (bank >= 0x80U && bank < 0xc0U)) || offset >= 0x2000U) return std::nullopt;
+        index = offset;
+        limit = 0x2000U;
+    }
+    // The range must stay inside the same mapping: a run that would cross the
+    // end of a mirror falls through to the byte accessors.
+    const auto room = limit - std::min(index, limit);
+    if (count > room || index + count > wram_size) return std::nullopt;
+    return index;
+}
+} // namespace
+
+bool Wdc65816::read_wram_block(std::uint32_t address, std::uint8_t* out, std::size_t count) const noexcept {
+    const auto index = plain_wram_index(address, count, impl_->wram.size());
+    if (!index) return false;
+    std::copy_n(impl_->wram.begin() + static_cast<std::ptrdiff_t>(*index), count, out);
+    return true;
+}
+
+bool Wdc65816::write_wram_block(std::uint32_t address, const std::uint8_t* in, std::size_t count) noexcept {
+    const auto index = plain_wram_index(address, count, impl_->wram.size());
+    if (!index) return false;
+    std::copy_n(in, count, impl_->wram.begin() + static_cast<std::ptrdiff_t>(*index));
+    return true;
+}
+
 void Wdc65816::write16(std::uint32_t address, std::uint16_t value) {
     write8(address, static_cast<std::uint8_t>(value));
     write8(address + 1U, static_cast<std::uint8_t>(value >> 8U));
