diff --git a/include/starfox/render/colour_math.hpp b/include/starfox/render/colour_math.hpp
index 6089da5..dacba77 100644
--- a/include/starfox/render/colour_math.hpp
+++ b/include/starfox/render/colour_math.hpp
@@ -1,6 +1,7 @@
 #pragma once
 
 #include "starfox/render/framebuffer.hpp"
+#include "starfox/render/row_workers.hpp"
 #include "starfox/simulation/game_simulation.hpp"
 #include <array>
 
@@ -9,20 +10,34 @@ namespace starfox::render {
 // Fixed-colour windows leave OBJ untouched unless CGADSUB explicitly includes
 // it. In particular, revival's blackfade must not erase the STAGE sprites.
 inline void apply_colour_math(const simulation::ColourMathEffectState& effect,
-    const Framebuffer& frame, std::vector<std::uint8_t>& rgba) {
+    const Framebuffer& frame, std::vector<std::uint8_t>& rgba,
+    RowWorkers* workers = nullptr) {
     if (!effect.active || effect.affected_layers == 0U
         || rgba.size() != frame.pixels().size()*4U) return;
     const auto expand = [](std::uint8_t v) { return int((v&31U)*8U + ((v&31U)>>2U)); };
     const std::array fixed{expand(effect.red),expand(effect.green),expand(effect.blue)};
-    for (std::size_t i=0; i<frame.pixels().size(); ++i) {
-        if (frame.pixels()[i]>=128U && (effect.affected_layers&0x10U)==0U) continue;
-        for (unsigned c=0; c<3; ++c) {
-            int value=rgba[i*4+c];
-            value=effect.subtract ? value-fixed[c] : value+fixed[c];
+    // The result depends only on the channel's byte, so tabulate it once per
+    // channel (same expression, same truncating halve and clamp) and let the
+    // pixels index it.
+    std::array<std::array<std::uint8_t,256>,3> table{};
+    for (unsigned c=0; c<3; ++c) {
+        for (int v=0; v<256; ++v) {
+            int value=effect.subtract ? v-fixed[c] : v+fixed[c];
             if (effect.half) value/=2;
-            rgba[i*4+c]=std::uint8_t(std::clamp(value,0,255));
+            table[c][v]=std::uint8_t(std::clamp(value,0,255));
         }
     }
+    const bool skip_sprites=(effect.affected_layers&0x10U)==0U;
+    const std::size_t width=frame.stored_width();
+    const auto& pixels=frame.pixels();
+    const auto band=[&](std::uint32_t first,std::uint32_t last) {
+        for (std::size_t i=std::size_t(first)*width; i<std::size_t(last)*width; ++i) {
+            if (skip_sprites && pixels[i]>=128U) continue;
+            std::uint8_t* p=&rgba[i*4];
+            p[0]=table[0][p[0]]; p[1]=table[1][p[1]]; p[2]=table[2][p[2]];
+        }
+    };
+    if (workers!=nullptr) workers->parallel_rows(frame.stored_height(),band); else band(0U,frame.stored_height());
 }
 
 } // namespace starfox::render
diff --git a/include/starfox/render/row_workers.hpp b/include/starfox/render/row_workers.hpp
index f1b93a4..1ec5c89 100644
--- a/include/starfox/render/row_workers.hpp
+++ b/include/starfox/render/row_workers.hpp
@@ -1,5 +1,6 @@
 #pragma once
 
+#include <atomic>
 #include <condition_variable>
 #include <cstdint>
 #include <functional>
@@ -30,27 +31,32 @@ public:
     void set_worker_count(std::size_t workers);
     [[nodiscard]] std::size_t worker_count() const noexcept { return workers_; }
 
-    // Runs `body(first_row, last_row)` over a half-open partition of
-    // [0, rows). The calling thread takes the first slice and waits for the
-    // rest, so no work is queued behind an idle dispatcher. `body` must not
-    // write outside the rows it is given.
+    // Runs `body(first_row, last_row)` over half-open bands that together
+    // cover [0, rows) exactly once. The calling thread and the workers claim
+    // bands from a shared counter, so uneven rows balance themselves; no
+    // assumption may be made about which thread runs which band or in what
+    // order. `body` must not write outside the rows it is given.
     void parallel_rows(
         std::uint32_t rows,
         const std::function<void(std::uint32_t, std::uint32_t)>& body);
 
 private:
     void stop_pool();
+    void run_chunks();
 
     std::vector<std::thread> pool_;
     std::mutex mutex_;
     std::condition_variable work_ready_;
     std::condition_variable work_done_;
     const std::function<void(std::uint32_t, std::uint32_t)>* job_{};
-    std::vector<std::uint32_t> job_bounds_;
+    std::uint32_t job_rows_{};
+    std::uint32_t job_chunk_{1U};
+    std::atomic<std::uint32_t> next_chunk_{0U};
     std::size_t workers_{};
     std::size_t pending_{};
     std::uint64_t generation_{};
     bool stopping_{false};
+    bool job_open_{false};
 };
 
 } // namespace starfox::render
