diff --git a/src/render/row_workers.cpp b/src/render/row_workers.cpp
index 69403a9..ad4adfe 100644
--- a/src/render/row_workers.cpp
+++ b/src/render/row_workers.cpp
@@ -25,11 +25,26 @@ void RowWorkers::stop_pool() {
     pool_.clear();
     generation_ = 0U;
     job_ = nullptr;
-    job_bounds_.clear();
     pending_ = 0U;
     stopping_ = false;
 }
 
+void RowWorkers::run_chunks() {
+    // Rows cost unevenly (models cover the middle of the frame, ground rows do
+    // more than sky), so an even split leaves the fast threads waiting for the
+    // slow one. Everyone instead claims small bands from a shared counter.
+    const auto* job = job_;
+    const auto rows = job_rows_;
+    const auto chunk = job_chunk_;
+    const auto chunks = (rows + chunk - 1U) / chunk;
+    for (;;) {
+        const auto index = next_chunk_.fetch_add(1U, std::memory_order_relaxed);
+        if (index >= chunks) return;
+        const auto first = index * chunk;
+        (*job)(first, std::min(rows, first + chunk));
+    }
+}
+
 void RowWorkers::set_worker_count(std::size_t workers) {
     if (workers == 0U) {
         const auto detected = std::thread::hardware_concurrency();
@@ -41,12 +56,9 @@ void RowWorkers::set_worker_count(std::size_t workers) {
     if (workers_ <= 1U) return;
     pool_.reserve(workers_ - 1U);
     for (std::size_t index = 0; index < workers_ - 1U; ++index) {
-        pool_.emplace_back([this, index] {
+        pool_.emplace_back([this] {
             std::uint64_t seen = 0U;
             for (;;) {
-                const std::function<void(std::uint32_t, std::uint32_t)>* job{};
-                std::uint32_t first = 0U;
-                std::uint32_t last = 0U;
                 {
                     std::unique_lock<std::mutex> lock{mutex_};
                     work_ready_.wait(lock, [this, &seen] {
@@ -54,15 +66,13 @@ void RowWorkers::set_worker_count(std::size_t workers) {
                     });
                     if (stopping_) return;
                     seen = generation_;
-                    // Slice 0 belongs to the dispatching thread.
-                    const auto slot = (index + 1U) * 2U;
-                    if (slot + 1U < job_bounds_.size()) {
-                        first = job_bounds_[slot];
-                        last = job_bounds_[slot + 1U];
-                        job = job_;
-                    }
+                    // A worker that wakes after every band was claimed (and
+                    // the dispatcher closed the job) has nothing to do and the
+                    // dispatcher does not wait for it.
+                    if (!job_open_) continue;
+                    ++pending_;
                 }
-                if (job != nullptr && first < last) (*job)(first, last);
+                run_chunks();
                 {
                     const std::lock_guard<std::mutex> lock{mutex_};
                     if (--pending_ == 0U) work_done_.notify_one();
@@ -90,33 +100,28 @@ void RowWorkers::parallel_rows(
         return;
     }
 
-    const auto span = rows / static_cast<std::uint32_t>(slices);
-    const auto remainder = rows % static_cast<std::uint32_t>(slices);
-
     {
         const std::lock_guard<std::mutex> lock{mutex_};
-        // Reuse the persistent job storage instead of allocating a temporary
-        // partition vector and copying it for every presentation pass.
-        job_bounds_.resize(slices * 2U);
-        std::uint32_t cursor = 0U;
-        for (std::size_t slice = 0; slice < slices; ++slice) {
-            const auto length = span
-                + (slice < remainder ? std::uint32_t{1U} : std::uint32_t{0U});
-            job_bounds_[slice * 2U] = cursor;
-            cursor += length;
-            job_bounds_[slice * 2U + 1U] = cursor;
-        }
         job_ = &body;
-        pending_ = pool_.size();
+        job_rows_ = rows;
+        // At least four bands per participant so uneven rows even out, but
+        // never bands so thin that claiming them costs more than they hold.
+        job_chunk_ = std::max<std::uint32_t>(
+            4U, rows / static_cast<std::uint32_t>(slices * 4U));
+        next_chunk_.store(0U, std::memory_order_relaxed);
+        pending_ = 0U;
+        job_open_ = true;
         ++generation_;
     }
     work_ready_.notify_all();
-    body(0U, span + (remainder != 0U ? 1U : 0U));
+    run_chunks();
     {
+        // Close the job to late wakers, then wait only for workers that are
+        // still inside a band.
         std::unique_lock<std::mutex> lock{mutex_};
+        job_open_ = false;
         work_done_.wait(lock, [this] { return pending_ == 0U; });
         job_ = nullptr;
-        job_bounds_.clear();
     }
 }
 
