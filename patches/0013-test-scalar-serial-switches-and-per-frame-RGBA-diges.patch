                 presentation_effects.host_overlay = &live_fps_overlay;
                 presentation_effects.host_overlay_x =
                     static_cast<std::int32_t>(display_width
@@ -9883,6 +9886,14 @@ int main(int argc, char** argv) {
             frame_profile.add(starfox::app::Stage::present_total,
                 profile_present_begin, std::chrono::steady_clock::now());
             window.finish_temporal_frame(temporal_presented);
+            if (test_frames != 0U && std::getenv("STARFOX_TRACE_FRAME_HASH") != nullptr) {
+                // The presented RGBA frame, after every CPU presentation pass.
+                std::uint64_t hash = 1469598103934665603ULL;
+                for (const auto byte : window.rgba()) hash = (hash ^ byte) * 1099511628211ULL;
+                std::fprintf(stderr, "rgba-hash %llu %016llx\n",
+                    static_cast<unsigned long long>(presented_frames),
+                    static_cast<unsigned long long>(hash));
+            }
             framebuffer.end_write_coverage();
             if (test_frames != 0 && presented_frames + 1U == test_frames) {
                 if (const auto* raw_capture = std::getenv("STARFOX_CAPTURE_INDEXED_PATH"))
