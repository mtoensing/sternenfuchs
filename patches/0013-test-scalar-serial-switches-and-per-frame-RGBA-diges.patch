diff --git a/include/starfox/render/hdr_effect.hpp b/include/starfox/render/hdr_effect.hpp
index 3143a76..fd77a3b 100644
--- a/include/starfox/render/hdr_effect.hpp
+++ b/include/starfox/render/hdr_effect.hpp
@@ -1,6 +1,7 @@
 #pragma once
 #include "starfox/render/framebuffer.hpp"
 #include "starfox/render/row_workers.hpp"
+#include "starfox/render/simd_switch.hpp"
 #include <array>
 #include <cmath>
 #include <cstring>
@@ -34,6 +35,7 @@ inline void apply_hdr_effect(const Framebuffer& frame,
         std::size_t pixel=std::size_t(first)*width;
         const std::size_t end=std::size_t(last)*width;
 #if defined(__ARM_NEON)
+        if (simd_enabled()) {
         // Four pixels per step: the 256-entry curve is four 64-byte table
         // lookups (out-of-range lanes read 0, so the four results OR together),
         // applied to R, G and B only; alpha and 2D-layer pixels keep their bytes.
@@ -58,6 +60,7 @@ inline void apply_hdr_effect(const Framebuffer& frame,
                     vqtbl4q_u8(table3,vsubq_u8(source,one_ninety_two))));
             vst1q_u8(rgba.data()+pixel*4,vbslq_u8(lane_mask,lut,source));
         }
+        }
 #endif
         for (;pixel<end;++pixel) {
             if (tags[pixel]==static_cast<std::uint8_t>(PixelLayer::two_d)) continue;
diff --git a/include/starfox/render/simd_switch.hpp b/include/starfox/render/simd_switch.hpp
new file mode 100644
index 0000000..a7bbc37
--- /dev/null
+++ b/include/starfox/render/simd_switch.hpp
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <cstdlib>
+
+namespace starfox::render {
+
+// STARFOX_NO_SIMD=1 selects the scalar loops behind every NEON fast path, so a
+// run can be compared byte for byte against the scalar reference.
+[[nodiscard]] inline bool simd_enabled() noexcept {
+    static const bool enabled = std::getenv("STARFOX_NO_SIMD") == nullptr;
+    return enabled;
+}
+
+} // namespace starfox::render
