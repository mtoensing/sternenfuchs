+    // Runs queue_logic_tick on a worker thread. The SPC/DSP render of one
+    // 50 ms logic tick is the single largest block on the game thread outside
+    // the tick itself, and its only product the game needs is the four APU
+    // output ports, which the cartridge next reads inside the following tick.
+    // collect_ports() therefore joins and hands the ports back right before
+    // that tick, so the game observes exactly the values the synchronous path
+    // would have produced. Anything else that touches the emulator waits first.
+    void submit_logic_tick(
+        std::span<const starfox::simulation::ApuPortWrite> writes,
+        std::span<const starfox::simulation::MsuRegisterWrite> msu_writes,
+        std::uint32_t speed_multiplier, bool queue_output) {
+        wait_idle();
+        job_writes_.assign(writes.begin(), writes.end());
+        job_msu_writes_.assign(msu_writes.begin(), msu_writes.end());
+        job_speed_ = speed_multiplier;
+        job_queue_output_ = queue_output;
+        if (!worker_.joinable()) {
+            worker_ = std::thread{[this] { worker_loop(); }};
+        }
+        {
+            const std::lock_guard<std::mutex> lock{job_mutex_};
+            job_pending_ = true;
+            job_result_ready_ = false;
+        }
+        job_cv_.notify_all();
+    }
+    // Joins any in-flight tick; returns true (and the ports) if one was
+    // submitted since the last call.
+    [[nodiscard]] bool collect_ports(std::array<std::uint8_t, 4>& ports) {
+        wait_idle();
+        std::unique_lock<std::mutex> lock{job_mutex_};
+        if (!job_result_ready_) return false;
+        job_result_ready_ = false;
+        ports = job_ports_;
+        if (job_error_) {
+            const auto error = job_error_;
+            job_error_ = nullptr;
+            lock.unlock();
+            std::rethrow_exception(error);
+        }
+        return true;
+    }
+
     [[nodiscard]] std::array<std::uint8_t, 4> queue_logic_tick(
         std::span<const starfox::simulation::ApuPortWrite> writes,
         std::span<const starfox::simulation::MsuRegisterWrite> msu_writes,
         std::uint32_t speed_multiplier, bool queue_output = true) {
+        wait_idle();
+        return queue_logic_tick_unlocked(writes, msu_writes, speed_multiplier, queue_output);
+    }
+
+private:
+    void wait_idle() const {
+        if (!worker_.joinable()) return;
+        std::unique_lock<std::mutex> lock{job_mutex_};
+        job_cv_.wait(lock, [this] { return !job_pending_; });
+    }
+    void stop_worker() {
+        if (!worker_.joinable()) return;
+        {
+            const std::lock_guard<std::mutex> lock{job_mutex_};
+            job_stop_ = true;
+        }
+        job_cv_.notify_all();
+        worker_.join();
+    }
+    void worker_loop() {
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lock{job_mutex_};
+                job_cv_.wait(lock, [this] { return job_pending_ || job_stop_; });
+                if (job_stop_ && !job_pending_) return;
+            }
+            std::array<std::uint8_t, 4> ports{};
+            std::exception_ptr error;
+            try {
+                ports = queue_logic_tick_unlocked(job_writes_, job_msu_writes_,
+                    job_speed_, job_queue_output_);
+            } catch (...) {
+                error = std::current_exception();
+            }
+            {
+                const std::lock_guard<std::mutex> lock{job_mutex_};
+                job_ports_ = ports;
+                job_error_ = error;
+                job_result_ready_ = true;
+                job_pending_ = false;
+            }
+            job_cv_.notify_all();
+        }
+    }
+
+    [[nodiscard]] std::array<std::uint8_t, 4> queue_logic_tick_unlocked(
+        std::span<const starfox::simulation::ApuPortWrite> writes,
+        std::span<const starfox::simulation::MsuRegisterWrite> msu_writes,
+        std::uint32_t speed_multiplier, bool queue_output) {
         starfox::audio::render_mixed_tick(emulator_,msu1_,writes,msu_writes,
             music_volume_,sfx_volume_,mixed_samples_);
         auto& samples = mixed_samples_;
@@ -3886,8 +3998,11 @@ public:
